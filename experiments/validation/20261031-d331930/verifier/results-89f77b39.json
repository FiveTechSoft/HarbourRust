    {
      "name": "t1354_idxcompound_stmt",
      "source": "// Indexed compound assignment, statement form (arrayidx family):\n// `a[i] op= e` for +, -, * on integer cells, with the resulting\n// value discarded, like a bare call statement (hk216).\nfunction main()\n   local a := { 1, 2, 3, 4 }\n   a[ 1 ] += 10\n   a[ 2 ] -= 10\n   a[ 3 ] *= 10\n   ? a[ 1 ], a[ 2 ], a[ 3 ], a[ 4 ]\nreturn nil\n",
