    {
      "name": "t1355_idxcompound_expr_order",
      "source": "// Order oracle for `a[i] op= e` used as an expression (arrayidx\n// contract): the index expression evaluates ONCE, FIRST; the rhs\n// evaluates once, second; the store targets the cell the FIRST\n// index evaluation named, even when the rhs mutates the index.\nfunction bump( x )\n   x := x + 1\n   return 5\nfunction main()\n   local a := { 10, 20, 30, 40 }\n   local index := 0\n   ? a[ ++index ] += bump( @index )\n   ? index\n   ? a[ 1 ], a[ 2 ], a[ 3 ], a[ 4 ]\nreturn nil\n",
      "targets": {
