request DBFCDX
function Main()
   dbUseArea(.T., "DBFCDX", "cdxprobe.dbf", "PROBE", .F., .F.)
   OrdCreate("unique.cdx", "UNIQUE", "NAME", {||FieldGet(1)}, .T.)
   OrdCondSet(,,,,,,,,,,.T.)
   OrdCreate("descending.cdx", "DESC", "NAME", {||FieldGet(1)})
   OrdCondSet("ID > 125", {||FieldGet(2)>125})
   OrdCreate("conditional.cdx", "COND", "NAME", {||FieldGet(1)})
   OrdCreate("numeric.cdx", "NUM", "ID", {||FieldGet(2)})
   OrdCreate("expression.cdx", "EXPR", "Upper(NAME)", {||Upper(FieldGet(1))})
   OrdCondSet(,,,,,,,,,,,,.T.)
   OrdCreate("multi.cdx", "FIRST", "NAME", {||FieldGet(1)})
   OrdCondSet(,,,,,,,,,,,,.T.)
   OrdCreate("multi.cdx", "SECOND", "ID", {||FieldGet(2)})
   dbCloseArea()
   dbCreate("zero", {{"NAME","C",12,0}}, "DBFCDX")
   dbUseArea(.T., "DBFCDX", "zero.dbf", "ZERO", .F., .F.)
   OrdCreate("zerokeys.cdx", "ZERO", "NAME", {||FieldGet(1)})
   dbCloseArea()
return nil
