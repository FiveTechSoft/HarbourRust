PROCEDURE MAIN()
local c, d
d := CToD("12/25/2026")
c := Transform("hello", "@!") ; ? "[" + c + "]"
c := Transform("hello", "@! XXXXX") ; ? "[" + c + "]"
c := Transform("hello", "XXXXXXXXXX") ; ? "[" + c + "]"
c := Transform("hello", "XXX") ; ? "[" + c + "]"
c := Transform("hello", "@R 99-999-99") ; ? "[" + c + "]"
c := Transform("12345", "@R 99-999-99") ; ? "[" + c + "]"
c := Transform("hello world", "@A XXXXXXXXXXXX") ; ? "[" + c + "]"
c := Transform("ab1", "AAA") ; ? "[" + c + "]"
c := Transform("ab1", "!!!") ; ? "[" + c + "]"
c := Transform("hello", "") ; ? "[" + c + "]"
c := Transform("hello", "@R X(X)X") ; ? "[" + c + "]"
c := Transform("aBcDe", "@!") ; ? "[" + c + "]"
c := Transform(d, "") ; ? "[" + c + "]"
c := Transform(d, "@D") ; ? "[" + c + "]"
c := Transform(d, "99/99/9999") ; ? "[" + c + "]"
c := Transform(d, "@E") ; ? "[" + c + "]"
c := Transform(.T., "") ; ? "[" + c + "]"
c := Transform(.F., "") ; ? "[" + c + "]"
c := Transform(.T., "Y") ; ? "[" + c + "]"
c := Transform(.T., "L") ; ? "[" + c + "]"
c := Transform("12345", "99999") ; ? "[" + c + "]"
c := Transform(12345, "XXXXXX") ; ? "[" + c + "]"
c := Transform(3.14159, "9.99") ; ? "[" + c + "]"
c := Transform(3.14159, "@R 9.99") ; ? "[" + c + "]"
c := Transform("hi", "@R <XXX>") ; ? "[" + c + "]"
RETURN
