procedure main()
   local x := 1.5
   local y := 2.25
   local a := -1.5
   local b := -2.25
   ? 1.5 + 2.25
   ? x + y
   ? 1.5 * 2.25
   ? x * y
   ? 1.5 - 2.25
   ? x - y
   ? 1.5 / 2.25
   ? x / y
   ? -1.5 + -2.25
   ? a + b
   ? -1.5 * -2.25
   ? a * b
   ? -1.5 - (-2.25)
   ? a - b
   ? -1.5 / -2.25
   ? a / b
   ? -1.5 / 2.25
   ? a / y
   ? 1.5 / -2.25
   ? x / b
   ? -2.25 * 4
   ? b * 4
   return
