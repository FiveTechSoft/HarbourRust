REQUEST DBFNTX
function Main()
local a:={{"NAME","C",8,0},{"ID","N",6,0},{"AMOUNT","N",10,2},{"OK","L",1,0},{"WHEN","D",8,0}},i
RddSetDefault("DBFNTX")
dbCreate("fixture.dbf",a,"DBFNTX")
dbUseArea(.T.,"DBFNTX","fixture.dbf","DATA",.F.,.F.)
dbAppend()
FieldPut(1,"alpha")
FieldPut(2,1)
FieldPut(3,-12.34)
FieldPut(4,.T.)
FieldPut(5,SToD("20240229"))
dbAppend()
FieldPut(1,"beta")
FieldPut(2,-2)
FieldPut(3,0)
FieldPut(4,.F.)
FieldPut(5,SToD(""))
dbDelete()
dbAppend()
FieldPut(1,"gamma")
FieldPut(2,123456)
FieldPut(3,999.99)
FieldPut(4,.T.)
FieldPut(5,SToD("19991231"))
dbCloseArea()
dbUseArea(.T.,"DBFNTX","fixture.dbf","DATA",.F.,.T.)
? "OPEN",RecNo(),LastRec(),Bof(),Eof(),ValType(dbGoTop())
? "TOP",RecNo(),Bof(),Eof()
for i:=1 to 4
? "REC",RecNo(),Deleted(),Bof(),Eof()
? "FIELDS",ValType(FieldGet(1)),Len(FieldGet(1)),FieldGet(1),ValType(FieldGet(2)),FieldGet(2),ValType(FieldGet(3)),FieldGet(3),ValType(FieldGet(4)),FieldGet(4),ValType(FieldGet(5)),DToS(FieldGet(5))
? "SKIPRET",ValType(dbSkip())
next
? "SKIPNEGRET",ValType(dbSkip(-100)),RecNo(),Bof(),Eof()
? "FIELD0",ValType(FieldGet(0)),ValType(FieldGet(99))
? "CLOSERET",ValType(dbCloseArea())
dbCreate("empty.dbf",a,"DBFNTX")
dbUseArea(.T.,"DBFNTX","empty.dbf","EMPTY",.F.,.T.)
? "EMPTY",RecNo(),LastRec(),Bof(),Eof()
dbGoTop()
? "EMPTYTOP",RecNo(),Bof(),Eof()
dbSkip()
? "EMPTYSKIP",RecNo(),Bof(),Eof()
dbCloseArea()
return nil
