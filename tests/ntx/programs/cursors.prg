function Main()
   dbUseArea(.T., "DBFNTX", "ntxprobe.dbf", "PROBE", .F., .T.)
   ? "physical", RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "addret", ValType(OrdListAdd("names.ntx"))
   ? "opened", RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "seekfirst", dbSeek("K000"), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "seeklast", dbSeek("K000", .F., .T.), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "prefix", dbSeek("K00"), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "prefixlast", dbSeek("K00", .F., .T.), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "empty", dbSeek(""), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "longer", dbSeek("K000        X"), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "miss", dbSeek("J"), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "softbefore", dbSeek("J", .T.), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "softbetween", dbSeek("K000X", .T.), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "softlast", dbSeek("K000X", .T., .T.), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "softafter", dbSeek("Z", .T.), RecNo(), FieldGet(1), Bof(), Eof(), Found()
   dbSkip(-1)
   ? "fromeof", RecNo(), FieldGet(1), Bof(), Eof(), Found()
   dbGoBottom()
   ? "bottom", RecNo(), FieldGet(1), Bof(), Eof(), Found()
   dbSkip(1)
   ? "afterbottom", RecNo(), FieldGet(1), Bof(), Eof(), Found()
   dbGoTop()
   dbSkip(-1)
   ? "beforetop", RecNo(), FieldGet(1), Bof(), Eof(), Found()
   dbSkip(0)
   ? "skipzero", RecNo(), FieldGet(1), Bof(), Eof(), Found()
   dbSkip(1)
   ? "next", RecNo(), FieldGet(1), Bof(), Eof(), Found()
   ? "seekclear", dbSeek("K000"), RecNo(), Found()
   OrdListClear()
   ? "clear", RecNo(), FieldGet(1), Bof(), Eof(), Found()
   dbSkip()
   ? "physicalnext", RecNo(), FieldGet(1), Bof(), Eof(), Found()
   dbCloseArea()
return nil
