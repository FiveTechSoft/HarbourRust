function Main()
   local a,b
   dbUseArea(.T.,"DBFNTX","ntxprobe.dbf","P",.F.,.T.)
   OrdListAdd("names.ntx")
   a:=FieldGet(1)
   dbSeek("K070",.F.,.T.)
   b:=FieldGet(1)
   OrdListClear()
   dbCloseArea()
   ? a,b,Empty(a),ValType(a)
   dbUseArea(.T.,"DBFNTX","ntxprobe.dbf","P",.F.,.T.)
   OrdListAdd("names.ntx")
   ? dbSeek("K001"+""), RecNo(), FieldGet(1)
   dbUseArea(.F.,"DBFNTX","ntxprobe.dbf","P",.F.,.T.)
   dbSkip()
   ? "reopenedphysical", RecNo(), FieldGet(1), Found()
   OrdListAdd("names")
   ? "extension", RecNo(), FieldGet(1), Found()
return nil
