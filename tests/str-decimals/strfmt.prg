procedure leak()
   local i, t := "", f := 0.0
   for i := 1 to 300
      f := f + 0.37
      t := Str(f, 9, 3) + StrZero(-f, 8, 1) + Str(Val(Str(f, 7, 2)) * 2, 8, 2)
   next
   OutStd("leak=[" + t + "]" + Chr(10))
return
