FUNCTION Main()
 LOCAL cLong:=Replicate("x",5000),cTarget:=Replicate("z",1000)
 ? "missing",hb_FLink("missing","new"),FError()
 ? "parent",hb_FLink("origin","absent/new"),FError()
 ? "notdir",hb_FLink("origin","origin/new"),FError()
 ? "source-notdir",hb_FLink("origin/child","new"),FError()
 ? "dest-dir",hb_FLink("origin","subdir"),FError()
 ? "source-dir",hb_FLink("subdir","new"),FError()
 ? "long-source",hb_FLink(cLong,"new"),FError()
 ? "long-dest",hb_FLink("origin",cLong),FError()
 ? "empty-source",hb_FLink("","new"),FError()
 ? "empty-dest",hb_FLink("origin",""),FError()
 ? "denied-source",hb_FLink("blocked/inside","new"),FError()
 ? "denied-dest",hb_FLink("origin","blocked/new"),FError()
 ? "loop-source",hb_FLink("loop/inside","new"),FError()
 ? "loop-dest",hb_FLink("origin","loop/new"),FError()
 ? "nul-source",hb_FLink("origin"+Chr(0)+"tail","nulhard"),FError()
 ? "nul-dest",hb_FLink("origin","nulhard2"+Chr(0)+"tail"),FError()
 ? "symlink-long-dest",hb_FLinkSym("a",cLong),FError()
 ? "symlink-notdir",hb_FLinkSym("a","origin/new"),FError()
 ? "symlink-empty-target",hb_FLinkSym("","blank"),FError()
 ? "symlink-long-target",hb_FLinkSym(cLong,"longlink"),FError()
 ? "symlink1000",hb_FLinkSym(cTarget,"target1000"),FError()
 ? "read1000",Len(hb_FLinkRead("target1000")),FError()
 ? "read-dir",hb_FLinkRead("subdir"),FError()
 ? "read-loop",hb_FLinkRead("loop/inside"),FError()
 ? "read-notdir",hb_FLinkRead("origin/new"),FError()
 ? "read-long",hb_FLinkRead(cLong),FError()
 ? "read-empty",hb_FLinkRead(""),FError()
 ? "memo-fail",hb_MemoWrit("missing/new","x"),FError()
 ? "dir-missing-parent",hb_DirCreate("missing/dir"),FError()
 ? "dir-notdir",hb_DirCreate("origin/new"),FError()
 ? "dir-long",hb_DirCreate(cLong),FError()
 ? "dir-empty",hb_DirCreate(""),FError()
RETURN NIL
