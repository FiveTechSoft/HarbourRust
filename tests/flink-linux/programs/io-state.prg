FUNCTION Main()
 LOCAL b:="123",h,r
 hb_FLink("missing","other")
 ? "start",FError()
 r:=FOpen("origin")
 ? "open-good",r>=0,FError()
 h:=r
 hb_FLink("missing","other")
 ? "read0",FRead(h,@b,0),FError()
 hb_FLink("missing","other")
 ? "read-excess",FRead(h,@b,4),FError()
 hb_FLink("missing","other")
 ? "read",FRead(h,@b,1),FError()
 hb_FLink("missing","other")
 ? "readstr",FReadStr(h,1),FError()
 hb_FLink("missing","other")
 ? "close-good",FClose(h),FError()
 hb_FLink("missing","other")
 ? "open-bad",FOpen("missing"),FError()
 hb_FLink("missing","other")
 ? "close-bad",FClose(-1),FError()
 hb_FLink("missing","other")
 ? "write-bad",FWrite(-1,"a"),FError()
 hb_FLink("missing","other")
 ? "write-zero-bad",FWrite(-1,""),FError()
 hb_FLink("missing","other")
 ? "read-bad",FRead(-1,@b,1),FError()
 hb_FLink("missing","other")
 ? "read-zero-bad",FRead(-1,@b,0),FError()
 hb_FLink("missing","other")
 ? "readstr-bad",FReadStr(-1,1),FError()
 hb_FLink("missing","other")
 ? "memo-good",hb_MemoWrit("memo","abc"),FError()
 hb_FLink("missing","other")
 ? "memo-bad",hb_MemoWrit("absent/new","abc"),FError()
 hb_FLink("missing","other")
 ? "dir-missing",hb_DirCreate("absent/new"),FError()
RETURN NIL
