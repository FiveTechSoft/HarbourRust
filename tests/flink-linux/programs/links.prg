 ? "read-symbolic",hb_FLinkRead("symbolic"),FError()
 ? "symbolic-exists",hb_FLinkSym("origin","symbolic"),FError()
 ? "dangling",hb_FLinkSym("missing","dangling"),FError()
 ? "read-dangling",hb_FLinkRead("dangling"),FError()
 ? "dir",hb_DirCreate("subdir"),FError()
 ? "dir-again",hb_DirCreate("subdir"),FError()
