// Prints PCount(), then main's six parameters, one per line, each
// between brackets.
procedure main(a, b, c, d, e, f)
   ? PCount()
   ? "["
   ?? a
   ?? "]"
   ? "["
   ?? b
   ?? "]"
   ? "["
   ?? c
   ?? "]"
   ? "["
   ?? d
   ?? "]"
   ? "["
   ?? e
   ?? "]"
   ? "["
   ?? f
   ?? "]"
return
