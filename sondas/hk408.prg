function show(x)
return QQOut(x)
function exercise()
local i
local a := AllTrim("12345678")
local b := AllTrim("abcdefghijklmnop")
for i := 1 to 20
if show("") == NIL
? Len(AllTrim(a)), Len(AllTrim(b))
endif
next
? a == "12345678", b == "abcdefghijklmnop"
return
function main()
exercise()
? 0
return
